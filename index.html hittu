<script>
(function(){
  /* split text for the load animation and the bio */
  document.querySelectorAll('[data-split]').forEach(function(el){
    el.innerHTML=el.textContent.split('').map(function(c){return '<span class="m"><span class="ch">'+c+'</span></span>'}).join('');
  });
  var bio=document.getElementById('bio');
  bio.innerHTML=bio.textContent.split(' ').map(function(w){return '<span class="w">'+w+'</span>'}).join(' ');
  if(!window.gsap) return;
  gsap.registerPlugin(ScrollTrigger);
  var mm=gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)',function(){
    gsap.from('.ch',{yPercent:110,opacity:0,stagger:.04,duration:1,ease:'power4.out'});
    gsap.from('.stage',{scale:.7,opacity:0,rotateY:-50,duration:1.4,ease:'expo.out',delay:.2});
    /* scroll-driven 360° with layers separating in depth */
    gsap.timeline({scrollTrigger:{trigger:'#top',start:'top top',end:'+=160%',scrub:1,pin:true}})
      .to('.stage',{rotateY:360,ease:'none'},0)
      .to('.frame',{z:110,ease:'none'},0)
      .to('.glow',{z:-140,scale:1.15,ease:'none'},0)
      .to('.chip',{z:180,ease:'none'},0)
      .to('.copy',{yPercent:-25,opacity:.35,ease:'none'},0);
    /* bio words light up while reading */
    gsap.fromTo('.w',{opacity:.18},{opacity:1,stagger:.1,ease:'none',scrollTrigger:{trigger:'#bio',start:'top 80%',end:'bottom 45%',scrub:true}});
    gsap.utils.toArray('.row').forEach(function(el){
      gsap.from(el,{rotateX:-40,y:40,opacity:0,transformOrigin:'top',duration:.9,ease:'power3.out',scrollTrigger:{trigger:el,start:'top 88%'}});
    });
    /* mouse tilt */
    window.addEventListener('pointermove',function(e){
      gsap.to('.tilt',{rotateY:(e.clientX/innerWidth-.5)*18,rotateX:-(e.clientY/innerHeight-.5)*18,duration:.6});
    });
  });
  /* magnetic buttons */
  document.querySelectorAll('.mag').forEach(function(b){
    b.addEventListener('pointermove',function(e){var r=b.getBoundingClientRect();gsap.to(b,{x:(e.clientX-r.left-r.width/2)*.25,y:(e.clientY-r.top-r.height/2)*.25,duration:.3})});
    b.addEventListener('pointerleave',function(){gsap.to(b,{x:0,y:0,duration:.6,ease:'elastic.out(1,0.4)'})});
  });
})();
</script>
<script>
(function(){
  /* OPTIONAL: paste the URL of your own backend here to use a real LLM (see notes). Leave empty to use the built-in answers. */
  var AI_ENDPOINT="";

  var KB=[
   {k:["who","about","introduce","yourself","tell me","summary","overview","describe"],a:"Hithyshi PM is a first-semester B.E. student in Artificial Intelligence and Machine Learning at BGSCET. She is also a trained Bharatanatyam dancer who has completed her senior exam, and she enjoys singing and drawing."},
   {k:["skill","tech","technology","tools","know","good at","stack","language","programming"],a:"Hithyshi's current skills:\n• C programming (beginner)\n• CAD (beginner)\n• Git and GitHub (she uses it comfortably)\nShe is early in her engineering journey and learning quickly."},
   {k:["c ","c programming"," c?"],a:"She is a beginner in C programming, learning it as part of her first semester."},
   {k:["cad","design software","drawing software"],a:"She is a beginner in CAD."},
   {k:["git","github","version control","repo","repository","code"],a:"Hithyshi uses Git and GitHub comfortably. Her GitHub is https://github.com/Hithyshi2008/Hithyshi-PM"},
   {k:["education","study","studying","college","school","degree","qualification","university","bgscet","narayana","claret","semester","branch","aiml","engineering","academic"],a:"Education:\n• St. Claret (school), passed out in 2024\n• Narayana PU College, passed out in 2026\n• BGSCET, currently in the 1st semester of B.E. in Artificial Intelligence and Machine Learning"},
   {k:["dance","dancing","bharatanatyam","bharathanatyam","classical","senior exam","performer","arts","art"],a:"Hithyshi has completed her senior exam in Bharatanatyam, the classical Indian dance form. Dancing is one of her main passions."},
   {k:["hobby","hobbies","interest","interests","sing","singing","draw","drawing","free time","passion","creative","fun","music"],a:"Outside studies she loves dancing, singing and drawing, and she enjoys thinking deeply about creative ideas."},
   {k:["project","projects","portfolio","built","build","work samples","made"],a:"She has no projects yet because she is in her first semester. Her first builds will be added to this site and her GitHub as she makes them."},
   {k:["experience","intern","internship","job","work","employment"],a:"Hithyshi has no internships or work experience yet, since she is a first-semester student. She is looking forward to learning and building."},
   {k:["contact","email","mail","phone","call","number","reach","github link","connect","message"],a:"You can reach Hithyshi at:\n• Email: hithyshi208@gmail.com\n• Phone: 9740744695\n• GitHub: https://github.com/Hithyshi2008/Hithyshi-PM"},
   {k:["hire","hiring","recruit","available","availability","opportunity","opportunities","collaborate","collaboration","open to","salary","resume","cv"],a:"I don't have details on her availability or a resume. Please email her directly at hithyshi208@gmail.com to discuss opportunities or collaboration."},
   {k:["strength","strengths","why","unique","special","personality","qualities"],a:"From what she has shared: she brings discipline from years of classical Bharatanatyam training, creativity across dance, music and drawing, and a curious, thoughtful mindset as she begins AIML engineering."},
   {k:["hello","hi","hey","namaste","good morning","good evening"],a:"Hello! I can tell you about Hithyshi's education, skills, interests and how to contact her. What would you like to know?"},
   {k:["thank","thanks","bye"],a:"You're welcome! Feel free to email Hithyshi at hithyshi208@gmail.com."}
  ];
  var FALLBACK="I only know what Hithyshi has shared on this site, and I don't have an answer to that. I can tell you about her education, skills, interests or contact details, or you can email her at hithyshi208@gmail.com.";
  var SUG=["Who is Hithyshi?","What are her skills?","Tell me about her education","Does she have projects?","How can I contact her?"];

  var btn=document.getElementById("ai-btn"),box=document.getElementById("ai-box"),log=document.getElementById("ai-log"),
      form=document.getElementById("ai-form"),inp=document.getElementById("ai-in"),sug=document.getElementById("ai-sug");

  function add(t,who){var d=document.createElement("div");d.className="msg "+who;d.textContent=t;log.appendChild(d);log.scrollTop=log.scrollHeight;return d}
  function local(q){
    q=" "+q.toLowerCase().replace(/[^a-z0-9? ]/g," ")+" ";
    var best=null,score=0;
    KB.forEach(function(e){var s=0;e.k.forEach(function(w){if(q.indexOf(w.length<=2?w:w)>-1)s+=w.length>3?2:1});if(s>score){score=s;best=e}});
    return best?best.a:FALLBACK;
  }
  function ask(q){
    q=q.trim();if(!q)return;add(q,"me");inp.value="";
    var d=add("…","bot");
    var done=function(a){setTimeout(function(){d.textContent=a;log.scrollTop=log.scrollHeight;speak(a)},350)};
    if(AI_ENDPOINT){
      fetch(AI_ENDPOINT,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({question:q})})
        .then(function(r){return r.json()}).then(function(j){done(j.answer||local(q))}).catch(function(){done(local(q))});
    }else done(local(q));
  }
  SUG.forEach(function(s){var b=document.createElement("button");b.type="button";b.textContent=s;b.onclick=function(){ask(s)};sug.appendChild(b)});
  form.addEventListener("submit",function(e){e.preventDefault();ask(inp.value)});
  btn.addEventListener("click",function(){
    var o=box.classList.toggle("open");if(!o){if(synth)synth.cancel();if(rec)rec.stop()}btn.setAttribute("aria-expanded",o);
    if(o){if(!log.children.length)add("Hi! I'm Hithyshi's assistant. I'm listening now, so ask out loud, or type your question. I'll answer in text and voice.","bot");startListen()}
  });

  /* VOICE: speaking answers (speechSynthesis) and listening (SpeechRecognition) */
  var spk=document.getElementById("ai-spk"),mic=document.getElementById("ai-mic"),voiceOn=true,rec=null;
  var synth=window.speechSynthesis;
  function clean(s){
    return s.replace(/https?:\/\/\S+/g,"the GitHub link shown in the chat")
            .replace(/hithyshi208@gmail\.com/g,"hithyshi 2 0 8 at gmail dot com")
            .replace(/\b(\d{10})\b/g,function(n){return n.split("").join(" ")})
            .replace(/•/g,"").replace(/\bB\.E\./g,"B E").replace(/\bAIML\b/g,"A I M L").replace(/\bCAD\b/g,"C A D").replace(/\bPM\b/g,"P M");
  }
  function speak(text){
    if(!voiceOn||!synth)return;
    synth.cancel();
    var u=new SpeechSynthesisUtterance(clean(text));
    var vs=synth.getVoices();
    var v=vs.filter(function(x){return x.lang==="en-IN"})[0]||vs.filter(function(x){return /^en/.test(x.lang)})[0];
    if(v)u.voice=v;u.lang=v?v.lang:"en-IN";u.rate=1;
    synth.speak(u);
  }
  if(synth)synth.onvoiceschanged=function(){};
  spk.addEventListener("click",function(){
    voiceOn=!voiceOn;spk.setAttribute("aria-pressed",voiceOn);spk.textContent=voiceOn?"Voice on":"Voice off";
    if(!voiceOn&&synth)synth.cancel();
  });
  var SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  window.startListen=function(){};
  if(!SR){mic.style.display="none"}
  else{
    window.startListen=function(){
      if(rec)return;
      if(synth)synth.cancel();
      rec=new SR();rec.lang="en-IN";rec.interimResults=false;rec.maxAlternatives=1;
      rec.onstart=function(){mic.classList.add("on");mic.textContent="Listening";inp.placeholder="Listening… speak now"};
      rec.onresult=function(e){var q=e.results[0][0].transcript;ask(q)};
      rec.onerror=function(e){
        if(e.error==="not-allowed"||e.error==="service-not-allowed")add("I can't use the microphone. Allow microphone access in your browser, or type your question instead.","bot");
        else if(e.error==="no-speech")add("I didn't hear anything. Tap Speak and try again.","bot");
      };
      rec.onend=function(){mic.classList.remove("on");mic.textContent="Speak";inp.placeholder="Ask anything about Hithyshi";rec=null};
      try{rec.start()}catch(x){rec=null}
    };
    mic.addEventListener("click",function(){if(rec)rec.stop();else startListen()});
  }
  document.getElementById("ai-clr").addEventListener("click",function(){
    if(synth)synth.cancel();
    log.innerHTML="";
    add("Chat cleared. Ask your next question out loud, or type it.","bot");
    startListen();
  });
  document.addEventListener("keydown",function(e){if(e.key==="Escape"&&box.classList.contains("open"))btn.click()});
})();
</script>
</body>
</html>
